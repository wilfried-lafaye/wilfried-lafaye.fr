---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<canvas id="neural-canvas" aria-hidden="true"></canvas>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />

		<!-- Inject global scripts -->
		<script src="/js/components/mobile-nav.js" is:inline defer></script>
		<script src="/js/components/scroll-reveal.js" is:inline defer></script>
		<script src="/js/components/active-nav.js" is:inline defer></script>
		<script src="/js/components/neural-network.js" is:inline defer></script>
	</body>
</html>
